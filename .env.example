FASTMAIL_TOKEN=fmu1-...

# Classifier: GreenPT (api.greenpt.ai). Confirm GREENPT_MODEL_ID against
# `curl https://api.greenpt.ai/v1/models -H "Authorization: Bearer $KEY"` --
# a plan restriction can hide a model the key cannot invoke. A new model also
# needs a measured entry in src/model-pacing.ts. See README.md, DECISIONS.md.
GREENPT_API_KEY=...
GREENPT_MODEL_ID=glm-5.3-flash

# Only needed with --apply and without --no-notify. Token from
# https://pushover.net/apps/build, user key from your Pushover dashboard.
PUSHOVER_TOKEN=...
PUSHOVER_USER=...

# All six below are optional: each skips one Mailbox/query lookup. The ids are
# stable across runs, so set them once you know them -- that is how the Lambda
# deployment avoids every lookup. Unset means auto-discover by path each run.

# Inbox/Triage -- source mailbox triage.ts polls and moves mail out of.
# TRIAGE_MAILBOX_ID=...
# Inbox -- destination for inbox.
# INBOX_MAILBOX_ID=...
# Inbox/Orders -- destination for orders.
# INBOX_ORDERS_MAILBOX_ID=...
# Inbox/News -- destination for newsletters.
# INBOX_NEWS_MAILBOX_ID=...
# Archive/Noise -- destination for noise.
# ARCHIVE_NOISE_MAILBOX_ID=...
# Inbox/Suspicious -- destination for suspicious.
# INBOX_SUSPICIOUS_MAILBOX_ID=...

# S3 bucket holding current.json / history/* -- created by the SAM template
# (PromptStoreBucket), not out of band like the secrets above, since a bucket
# name isn't a secret. Required on the CLI path too, not just the MCP server:
# there is no local prompt to fall back to (DECISIONS.md).
PROMPT_BUCKET=...

# For running the MCP server locally (npx tsx src/mcp-server.ts). The deployed
# Lambda uses MCP_BEARER_TOKEN_PARAM (an SSM parameter name) instead -- though
# it currently sets neither, see README.md.
# MCP_BEARER_TOKEN=...
# PORT=8080
