FASTMAIL_TOKEN=fmu1-...

# triage.ts only. Bedrock model IDs change over time -- look up the current
# Claude Haiku model ID available in eu-central-1 rather than guessing:
#   aws bedrock list-foundation-models --region eu-central-1 --by-provider anthropic
# AWS credentials themselves are NOT read from this file -- they come from the
# standard AWS SDK credential chain (env vars, ~/.aws/credentials, SSO, etc).
BEDROCK_MODEL_ID=anthropic....

# Required only when running with --apply and without --no-notify (v5).
# Create an application at https://pushover.net/apps/build for a token, and
# find your user key on your Pushover dashboard at https://pushover.net/.
PUSHOVER_TOKEN=...
PUSHOVER_USER=...

# All five below are optional. Each skips one Mailbox/query lookup and uses
# the given id directly -- saves a JMAP round trip. Every id is stable across
# runs, so these are meant to be set once you know them (e.g. from a prior
# run's output, or a Mailbox/query you've already run) and are how the
# future Lambda deployment will avoid every lookup on each invocation. Leave
# any of them unset to auto-discover that mailbox by path on every run.

# Inbox/Triage -- source mailbox triage.ts polls and moves mail out of.
# TRIAGE_MAILBOX_ID=...
# Inbox -- destination for inbox.
# INBOX_MAILBOX_ID=...
# Inbox/Orders -- destination for orders.
# INBOX_ORDERS_MAILBOX_ID=...
# Inbox/News -- destination for newsletters.
# INBOX_NEWS_MAILBOX_ID=...
# Archive/Noise -- destination for noise.
# ARCHIVE_NOISE_MAILBOX_ID=...
# Inbox/Suspicious -- destination for suspicious.
# INBOX_SUSPICIOUS_MAILBOX_ID=...
