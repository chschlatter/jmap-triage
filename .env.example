FASTMAIL_TOKEN=fmu1-...

# triage.ts only. Which classifier backend config.ts's requireModelConfig()
# builds -- "bedrock" (default, used when unset) or "mistral". See
# src/classify.ts's ClassifierConfig.
# MODEL_PROVIDER=bedrock

# Required when MODEL_PROVIDER is unset or "bedrock". Bedrock model IDs
# change over time -- look up the current model ID available in
# eu-central-1 rather than guessing:
#   aws bedrock list-foundation-models --region eu-central-1
# Whichever model you pick, add its RPM quota to src/model-pacing.ts so
# classify calls stay correctly paced -- see that file's comment.
# AWS credentials themselves are NOT read from this file -- they come from the
# standard AWS SDK credential chain (env vars, ~/.aws/credentials, SSO, etc).
BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0

# Required when MODEL_PROVIDER=mistral. Called directly against Mistral's
# own EU-hosted API (api.mistral.ai), not through Bedrock. Get a key at
# https://console.mistral.ai/ -- not every model name Mistral documents is
# available on every account's tier (mistral-large-latest returned 403
# tier_not_allowed on the account this was validated against), verify with
# a direct API call before picking MISTRAL_MODEL_ID. Whichever model you
# pick, add its rate limit to src/model-pacing.ts's Mistral table, measured
# empirically the same way the existing entry was, not guessed.
# MISTRAL_API_KEY=...
# MISTRAL_MODEL_ID=mistral-medium-latest

# Required only when running with --apply and without --no-notify (v5).
# Create an application at https://pushover.net/apps/build for a token, and
# find your user key on your Pushover dashboard at https://pushover.net/.
PUSHOVER_TOKEN=...
PUSHOVER_USER=...

# All five below are optional. Each skips one Mailbox/query lookup and uses
# the given id directly -- saves a JMAP round trip. Every id is stable across
# runs, so these are meant to be set once you know them (e.g. from a prior
# run's output, or a Mailbox/query you've already run) and are how the
# future Lambda deployment will avoid every lookup on each invocation. Leave
# any of them unset to auto-discover that mailbox by path on every run.

# Inbox/Triage -- source mailbox triage.ts polls and moves mail out of.
# TRIAGE_MAILBOX_ID=...
# Inbox -- destination for inbox.
# INBOX_MAILBOX_ID=...
# Inbox/Orders -- destination for orders.
# INBOX_ORDERS_MAILBOX_ID=...
# Inbox/News -- destination for newsletters.
# INBOX_NEWS_MAILBOX_ID=...
# Archive/Noise -- destination for noise.
# ARCHIVE_NOISE_MAILBOX_ID=...
# Inbox/Suspicious -- destination for suspicious.
# INBOX_SUSPICIOUS_MAILBOX_ID=...

# Required by triage.ts/main.ts's CLI path too (not jmap-triage-mcp-only
# anymore) -- there is no bundled local prompt.ts to fall back to (removed
# 2026-09-03; the real prompt describes a specific person, so a
# safe-to-commit bundled copy would have to be either generic-and-wrong or
# PII-bearing-and-uncommittable). Every path -- CLI, eval, Lambda,
# jmap-triage-mcp -- fetches the live prompt from S3's current.json.
#
# S3 bucket holding current.json / history/* -- see PromptStoreBucket in
# template.yaml (created by the SAM template, not out of band like the
# secrets above -- a bucket name isn't a secret).
PROMPT_BUCKET=...

# For running the MCP server locally (npx tsx src/mcp-server.ts). One of
# these two, not both -- MCP_BEARER_TOKEN for local dev, MCP_BEARER_TOKEN_PARAM
# (an SSM SecureString parameter name) for the deployed Lambda.
# MCP_BEARER_TOKEN=...
# PORT=8080
